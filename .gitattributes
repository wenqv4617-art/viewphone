# ============================================================
# 微光机 ViewPhone · 行尾与文本属性
# 目的：Windows 检出不得引入 CRLF。
# 宪法 §四.2 的提示词 golden 红线要求「编译产物逐字节一致」，
# golden 夹具若被 CRLF 污染，红灯会出现在完全无关的地方。
# ============================================================

# 默认：文本文件入库统一 LF，检出按 LF
* text=auto eol=lf

# 明确二进制的类型，禁止任何行尾转换
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.jks   binary
*.keystore binary
*.onnx  binary

# Windows 批处理必须是 CRLF，否则 cmd 解析异常
*.bat  text eol=crlf
*.cmd  text eol=crlf

# GitHub 语言统计
*.kt    linguist-language=Kotlin
*.kts   linguist-language=Kotlin
