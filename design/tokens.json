{
  "name": "viewphone",
  "title": "微光机 ViewPhone",
  "version": "0.1.0",
  "status": "draft-for-review",
  "direction": "极简留白（方向 1）",
  "note": "本文件是设计的唯一事实源。Compose Theme 与 Web CSS 变量由它生成，禁止手写色值。",
  "frontmatter": {
    "name": "viewphone-minimal-light",
    "tags": ["light-mode", "minimal", "blue-accent", "mobile", "rounded", "clean", "cjk-type"],
    "platform": "mobile"
  },

  "meta": {
    "canvas": { "width": 390, "height": 844, "shellRadius": 40 },
    "grid": { "columns": 4, "gutter": 16, "base": 4 },
    "principles": [
      "浅色为主：底色为接近白的冷灰，不是纯白，避免刺眼",
      "单一强调色：只有 #3B6FE0 一个彩色，且只出现在 3 处（状态点 / 发送按钮 / 激活项）",
      "微光 = 高亮度小面积：状态点、流式光标、按钮按下态；禁止扩散光晕与大面积发光",
      "图标一律矢量 SVG（24 栅格），禁止 emoji，禁止用位图当图标",
      "所有颜色 / 圆角 / 间距 / 字号只能取自本文件，禁止裸值"
    ]
  },

  "color": {
    "light": {
      "bg-base": "#F5F6F8",
      "bg-surface": "#FFFFFF",
      "bg-surface-2": "#EEF1F6",
      "bg-elevated": "#FFFFFF",
      "text-primary": "#1B1F27",
      "text-secondary": "#6B7280",
      "text-tertiary-decorative-only": {
        "value": "#9AA2AF",
        "rule": "禁止用于文字（对比度 2.57:1）。仅限分隔线/占位图形等装饰性元素。",
        "textInstead": "#6B7280",
        "textInsteadNote": "#6B7280 对表面 4.83:1 达标；对底色 #F5F6F8 为 4.47:1（差 0.03）。若要求任何底色下都 ≥4.5:1，改用 #686F7B（5.06/4.68）或 #666D78（5.22/4.83）。"
      },
      "outline": "#E6E9EF",
      "outline-strong": "#D3D9E2",
      "accent": "#3B6FE0",
      "accent-pressed": "#2F5AC4",
      "accent-soft": "#EAF0FF",
      "on-accent": "#FFFFFF",
      "glow": "#3B6FE0",
      "glow-alpha": 0.11,
      "unread-dot": "#E5484D",
      "success": "#3DD68C",
      "warning": "#F5A524",
      "error": "#E5484D"
    },
    "chat": {
      "bubble-char-bg": "#FFFFFF",
      "bubble-char-text": "#1B1F27",
      "bubble-char-outline": "#E6E9EF",
      "bubble-user-bg": "#22262B",
      "bubble-user-text": "#FFFFFF",
      "bubble-user-note": "强调色不用于气泡（符合提示词第三条）",
      "bubble-system-text": "#6B7280",
      "bubble-divider": "#E6E9EF",
      "typing-caret": "#3B6FE0"
    },
    "app-tiles": {
      "note": "每个应用入口一个浅彩底 + 同色系深字。以 hex 为准（对比度 4.84~6.97:1 全部达标）；OKLCH 仅为参考区间，其值为 sRGB 可达范围内的近似，禁止为凑标准改色致艳。",
      "oklchReference": {
        "standard": "底 L=92~94% C=0.05~0.07 ｜ 字 L=38~45% C=0.10~0.12",
        "caveat": "部分色相在 sRGB 内达不到 C=0.05~0.07（蓝 248° 上限≈0.036、紫 250°≈0.036、砖红 57°≈0.048）",
        "authority": "hex"
      },
      "chat-app": { "bg": "#E3EBFA", "ink": "#2B4C8C", "contrast": "6.97:1" },
      "character": { "bg": "#D7EFDD", "ink": "#2F6B4A", "contrast": "5.20:1", "changedFrom": "#EAF3EC" },
      "world": { "bg": "#EAE5F4", "ink": "#5A3E96", "contrast": "6.63:1", "changedFrom": "#F2EDFA" },
      "memory": { "bg": "#E6F1F3", "ink": "#26606B", "contrast": "6.15:1" },
      "music": { "bg": "#F9E8F0", "ink": "#8C2F63", "contrast": "6.60:1" },
      "reader": { "bg": "#FBEDE6", "ink": "#8C4A2B", "contrast": "5.87:1" },
      "gallery": { "bg": "#F1E7CE", "ink": "#7A6023", "contrast": "4.84:1", "changedFrom": "#F7F0DF" },
      "settings": { "bg": "#EDEFF3", "ink": "#4A5261", "contrast": "6.83:1" }
    }
  },

  "contrast": {
    "note": "正文 ≥4.5:1，大字 ≥3:1。实测值，改动色值后必须重算。",
    "pairs": [
      { "scene": "正文 / 底色", "fg": "#1B1F27", "bg": "#F5F6F8", "ratio": "15.27:1", "pass": true },
      { "scene": "正文 / 表面", "fg": "#1B1F27", "bg": "#FFFFFF", "ratio": "16.51:1", "pass": true },
      { "scene": "次要 + 时间戳 + 说明小字 / 表面", "fg": "#6B7280", "bg": "#FFFFFF", "ratio": "4.83:1", "pass": true },
      { "scene": "次要 + 时间戳 + 说明小字 / 底色", "fg": "#6B7280", "bg": "#F5F6F8", "ratio": "4.47:1", "pass": false, "fix": "改用 #686F7B（4.68:1）或 #666D78（4.83:1）" },
      { "scene": "强调色 / 表面", "fg": "#3B6FE0", "bg": "#FFFFFF", "ratio": "4.63:1", "pass": true },
      { "scene": "白字 / 用户气泡", "fg": "#FFFFFF", "bg": "#22262B", "ratio": "15.22:1", "pass": true },
      { "scene": "装饰性（禁止文字）/ 表面", "fg": "#9AA2AF", "bg": "#FFFFFF", "ratio": "2.57:1", "pass": false, "fix": "禁止用于文字" }
    ]
  },

"typography": {
    "fontFamily": {
      "cjk": ["HarmonyOS Sans SC", "PingFang SC", "Source Han Sans SC", "Noto Sans CJK SC", "sans-serif"],
      "latin": ["Inter", "SF Pro Text", "Segoe UI", "Roboto", "sans-serif"],
      "mono": ["JetBrains Mono", "SF Mono", "Consolas", "monospace"]
    },
    "scale": {
      "display": { "size": 76, "weight": 200, "lineHeight": 1.0, "letterSpacing": -1.5 },
      "largeTitle": { "size": 30, "weight": 600, "lineHeight": 1.2, "letterSpacing": -0.4 },
      "title": { "size": 22, "weight": 600, "lineHeight": 1.25, "letterSpacing": -0.3 },
      "headline": { "size": 17, "weight": 600, "lineHeight": 1.3, "letterSpacing": -0.2 },
      "body": { "size": 15, "weight": 400, "lineHeight": 1.5, "letterSpacing": 0 },
      "label": { "size": 13, "weight": 500, "lineHeight": 1.4, "letterSpacing": 0 },
      "caption": { "size": 12, "weight": 400, "lineHeight": 1.4, "letterSpacing": 0 },
      "micro": { "size": 11, "weight": 400, "lineHeight": 1.35, "letterSpacing": 0 },
      "iconGlyph": { "size": 27, "weight": 600, "lineHeight": 1.0, "letterSpacing": 0 }
    },
    "weights": { "light": 200, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },

  "space": {
    "note": "4pt 栅格，禁止任意值",
    "scale": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48],
    "semantic": {
      "screenPaddingX": 20,
      "sectionGap": 24,
      "cardPadding": 16,
      "listRowGap": 12,
      "iconToLabel": 8,
      "statusBarHeight": 44,
      "navBarHeight": 62,
      "inputBarHeight": 96,
      "dockHeight": 84,
      "dockRadius": 30,
      "tabBarHeight": 96
    }
  },

  "radius": {
    "xs": 8,
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 22,
    "full": 9999,
    "applied": {
      "card": 14,
      "bubble": 18,
      "appTile": 18,
      "searchPill": 20,
      "button": 14,
      "dock": 30,
      "avatar": "full",
      "statusDot": "full",
      "shell": 40
    }
  },

  "elevation": {
    "note": "浅色为主 + 低调阴影；卡片优先用描边而非阴影，仅弹层用阴影",
    "e1": { "shadow": "0 1px 2px rgba(17,20,24,0.06)", "usage": "卡片轻轻浮起（可选）" },
    "e2": { "shadow": "0 4px 12px rgba(17,20,24,0.08)", "usage": "弹层、浮动的回到底部胶囊" },
    "e3": { "shadow": "0 12px 32px rgba(17,20,24,0.12)", "usage": "模态、抽屉" }
  },

  "motion": {
    "duration": { "fast": 150, "base": 250, "emphasis": 350 },
    "spring": { "damping": 0.78, "stiffness": 380 },
    "reduced": "「减弱动态效果」开启后全部降为 150ms 淡入淡出，循环类动效停用"
  },

  "glow": {
    "note": "微光 = 高亮度小面积点缀，全屏 ≤ 2 处；禁止扩散光晕",
    "allowed": [
      "未读 / 在线状态点（直径 8–10）",
      "流式打字光标",
      "发送按钮按下态",
      "底部导航激活指示"
    ],
    "forbidden": ["大面积发光背景", "霓虹描边", "扫描线", "赛博朋克堆砌"]
  },

  "icons": {
    "note": "一律矢量 SVG；本设计稿里的汉字字形只是占位，实施时替换为 SVG 图标",
    "grid": 24,
    "strokeWidth": 1.75,
    "cap": "round",
    "join": "round",
    "sizes": { "inline": 14, "list": 18, "action": 20, "header": 24, "appEntry": 26 },
    "colorStates": { "active": "#3B6FE0", "default": "#6B7280", "muted": "#9AA2AF", "onAccent": "#FFFFFF" },
    "appEntrySet": {
      "chat": "对话气泡（圆角矩形 + 小尾巴）",
      "character": "人像（圆 + 肩线）",
      "world": "地球（圆 + 经纬线）",
      "memory": "书签 / 星标（菱形星）",
      "music": "音符（符头 + 符干）",
      "reader": "翻开的书（两页弧线）",
      "gallery": "照片（圆角矩形 + 山形 + 太阳）",
      "settings": "齿轮（圆 + 六齿）"
    },
    "forbidden": ["emoji 作为图标", "位图图标", "描边粗细不统一", "同一入口出现两套图标"]
  }
}
